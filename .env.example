# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONNECTION CONFIGURATION:
# Provide these in the Secrets/Settings panel to link your live Supabase database.
SUPABASE_URL="https://wkwhhkdpwmmtnuxroagz.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_DvNDiZbbc0hD8CobJ3pAWQ_TmOcRXcF"
SUPABASE_SECRET_KEY="sb_secret_Yl9jOdZsh6QvJFZEcFcMeA_I_ktTlvZ"
SUPABASE_JWKS_URL="https://wkwhhkdpwmmtnuxroagz.supabase.co/auth/v1/.well-known/jwks.json"

# DIRECT POSTGRESQL CONNECTION (LOCAL OR DOCKER):
# Used when migrating away from Supabase to a local or direct PostgreSQL instance.
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/leads_db"
